# Copy to .env for local development and fill in real values.
# In a deployed environment these are injected as process environment
# variables instead, and no .env file is present.

#DB
DB_USER=greenlight_user
DB_PASSWORD=your-password
DB_NAME=greenlight
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable

#SMTP
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_HOST="127.0.0.1"
SMTP_PORT=1025
SMTP_SENDER="Greenlight API <no-reply@greenlight.sanjayojha.dev>"
